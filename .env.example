# JalKrishi AI - Environment Configuration Example
# Copy to .env for production/local customization

# Frontend Base API URL
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Backend Environment & Server Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Ingestion & Data Mode (Honest Demo Mode)
DATA_MODE=DEMO_SIMULATION

# Safety Limits
CSV_MAX_SIZE_BYTES=5242880
MAX_PAGINATION_LIMIT=10000

# CORS Allowed Origins (Comma separated or JSON array)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
